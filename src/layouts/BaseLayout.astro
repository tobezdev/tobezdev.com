---
const { title: t } = Astro.props;
const pageTitle = t ? `${t} | tobezdev.com` : 'tobezdev.com';

const baseBackgroundStyle = 'bg-[#111314]';

import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class={baseBackgroundStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Welcome to my tiny corner of the internet :)" />
    <meta name="author" content="tobezdev" />
    <meta name="theme-color" content="#111314" />
    <meta name="robots" content="noarchive" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content="Welcome to my tiny corner of the internet :)" />
    <meta property="og:url" content="https://www.tobezdev.com/" />
    <meta property="og:image" content="/favicon.png" />
    <meta http-equiv="content-language" content="en">
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://tobezdev.com/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen {baseBackgroundStyle}">
    <slot />
  </body>
</html>
